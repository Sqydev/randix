pkgname=randix
pkgver=1.0.0
pkgrel=1
pkgdesc="A simple terminal program that displays random characters."
arch=('x86_64')
url="https://github.com/Sqydev/randix"
license=('GPL3')
depends=()
# Pobieramy BIN_NAME_REMOTE, ale zapisujemy lokalnie jako nazwa pakietu (randix)
source=("randix::https://github.com/Sqydev/randix/releases/download/v1.0.0/randix-normal-glibc")
sha256sums=('0025ac5df997530defd8cc4e8d370a176a1536cebbf6714f92a1edfc53843a97')

package() {
    install -Dm755 "$srcdir/randix" "$pkgdir/usr/bin/$pkgname"
}
